{
  "name": "mocakit",
  "version": "0.2.0",
  "description": "Typed TypeScript SDK and code generator for MOCA (Blue Yonder / RedPrairie WMS)",
  "keywords": [
    "moca",
    "blue-yonder",
    "redprairie",
    "wms",
    "jda",
    "sdk",
    "typescript",
    "codegen"
  ],
  "author": "Nicholas Saway (https://github.com/rnsaway)",
  "homepage": "https://github.com/rnsaway/mocakit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnsaway/mocakit.git"
  },
  "bugs": {
    "url": "https://github.com/rnsaway/mocakit/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "mocakit": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate": "tsx src/cli.ts generate",
    "prepare": "npm run build"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
